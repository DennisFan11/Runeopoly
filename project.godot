; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Runeopoly"
run/main_scene="res://MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PathfindingServer="*res://GPU_pathfind/PathfindingServer.tscn"
SoundManager="*res://Sound/SoundManager.gd"
MessageManager="*res://message_manager.gd"

[display]

window/size/transparent=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://GameLoopFSM/": "blue",
"res://GameLoopFSM/GameBoard/PlayerIcon/": "red",
"res://GameLoopFSM/_Blocks/": "green",
"res://GameLoopFSM/_Blocks/BlockType/Box/": "green",
"res://GameLoopFSM/_Blocks/BlockType/Mountain/": "green",
"res://GameLoopFSM/_Blocks/BlockType/_Boss/": "red",
"res://GameLoopFSM/_World/": "yellow",
"res://GameLoopFSM/_World/BattleUI/": "red",
"res://GameLoopFSM/_World/Components/": "yellow",
"res://GameLoopFSM/_World/Components/ItemSpwanner/": "red",
"res://Items/Chargeable_Item/": "gray",
"res://Items/Data_ Item/": "gray",
"res://Items/Destructible_Item/": "purple",
"res://MainMenu/": "purple",
"res://Shop/": "orange",
"res://Shop/iAgile/": "red",
"res://Shop/iGoldenTouch/": "red",
"res://Shop/iRegeneration/": "red",
"res://Shop/iToxicSpread/": "red",
"res://Shop/iVampire/": "red",
"res://TestStuff/": "green",
"res://ToolClass/": "green",
"res://Unit/": "red",
"res://Unit/Effect/fonts/": "orange",
"res://Unit/components/": "green",
"res://Unit/player/asset/": "orange"
}

[global_group]

EntryPoint="地圖進入點"
EnemySpawnPoint="敵人刷新點"
Wall="地圖牆"
Item=""
ShopItem=""
Buyer=""

